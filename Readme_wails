# 1) Wails CLI
go install github.com/wailsapp/wails/v2/cmd/wails@latest
export PATH="$(go env GOPATH)/bin:$PATH"

# 2) WebView deps
sudo apt update
sudo apt install -y libwebkit2gtk-4.1-dev build-essential pkg-config

# (ak treba) alias pre pkg-config (Wails hľadá 4.0)
sudo ln -s $(pkg-config --variable=pcfiledir webkit2gtk-4.1)/webkit2gtk-4.1.pc \
  $(pkg-config --variable=pcfiledir webkit2gtk-4.1)/webkit2gtk-4.0.pc

# 3) Frontend deps
cd frontend
npm install
cd ..

# 4) PDF/LaTeX tools
sudo apt install -y poppler-utils texlive-latex-base texlive-latex-recommended texlive-latex-extra pdftk

# 5) Build and run
wails build
